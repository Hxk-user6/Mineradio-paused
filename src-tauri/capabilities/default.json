{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Mineradio capabilities for main and overlay windows",
  "windows": [
    "main",
    "desktop-lyrics"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "global-shortcut:default",
    "dialog:default"
  ]
}
